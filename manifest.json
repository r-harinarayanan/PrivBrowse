{
  "manifest_version": 3,
  "name": "PrivBrowse — On-Device Privacy Browser Agent",
  "version": "1.2.0",
  "description": "On-Device Visual Perception for Light-Weight Browser Agents (SIH 2026, PS ID SIH26171). Zero PII leaves your device.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "offscreen",
    "contextMenus"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "run-agent": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Trigger PrivBrowse Zero-PII Automation"
    }
  },
  "host_permissions": [
    "<all_urls>",
    "http://*/*",
    "https://*/*",
    "file:///*",
    "https://huggingface.co/*",
    "https://cdn.jsdelivr.net/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; connect-src 'self' http://localhost:* http://127.0.0.1:* https://cdn.jsdelivr.net https://huggingface.co https://*.huggingface.co data: blob:;"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PrivBrowse Enterprise Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": ["sanitize.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
